# ==========================================
# Docker Production Environment Variables
# Copy to `.env.prod` on your production server:
# cp .env.prod.example .env.prod
# ==========================================

# Database Credentials (PLEASE CHANGE TO STRONG SECRETS!)
POSTGRES_DB=food_erp
POSTGRES_USER=food_erp_admin
POSTGRES_PASSWORD=password

# Production Web Server Port (Defaults to 80 for standard HTTP)
PROD_PORT=80
