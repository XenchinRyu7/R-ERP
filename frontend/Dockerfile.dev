# ==========================================
# Frontend Development Dockerfile (Vite HMR)
# ==========================================
FROM node:20-alpine

WORKDIR /app

# Install dependencies (cached layer)
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Copy application files
COPY . .

# Expose Vite default port
EXPOSE 5173

ENV HOST=0.0.0.0
ENV PORT=5173

# Start Vite dev server with host binding for Docker port mapping
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
