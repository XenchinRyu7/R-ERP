# ==========================================
# Frontend Production Multi-Stage Dockerfile
# Stage 1: Build production bundle
# Stage 2: Serve via Nginx reverse proxy
# ==========================================

# ---- Build Stage ----
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency definitions
COPY package*.json ./

# Install dependencies (use legacy-peer-deps for React 19 / HeroUI compatibility)
RUN npm install --legacy-peer-deps

# Copy application source code
COPY . .

# Build static assets (TypeScript check + Vite bundle)
RUN npm run build

# ---- Production Runtime Stage ----
FROM nginx:1.27-alpine AS runner

# Remove default nginx static html
RUN rm -rf /usr/share/nginx/html/*

# Copy built production assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration as main configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Expose standard HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/healthz || exit 1

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
